# Optional: enable LLM-based intent classification.
# Leave USER_LLM_API_KEY unset to run fully offline with the deterministic
# rule-based classifier. Provide your own key; never commit real secrets.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# Optional: override the SQLite database location.
# BI_DB_PATH=./data/sales.db
